{
  "name": "mail-test-windows",
  "version": "0.1.0",
  "private": true,
  "description": "Test: Mail mit Anhängen an eM Client übergeben",
  "main": "main.js",
  "author": "Baustellen-Doku",
  "scripts": { "start": "electron .", "dist": "electron-builder --win portable --publish never" },
  "build": {
    "appId": "it.baustelle.mailtest.win",
