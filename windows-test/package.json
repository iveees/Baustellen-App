    "files": ["main.js", "index.html", "mapi.ps1"],
    "win": { "target": "portable" },
    "portable": { "artifactName": "MailTest-Windows.exe" }
  },
  "devDependencies": { "electron": "31.7.7", "electron-builder": "24.13.3" }
}
